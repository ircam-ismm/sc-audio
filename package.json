{
  "name": "@ircam/sc-audio",
  "version": "0.1.0",
  "contributors": [
    "Benjamin Matuszewski",
    "Jean-Philippe Lambert"
  ],
  "description": "Web Audio synthesizers, effects and utilities",
  "license": "BSD-3-Clause",
  "keywords": [
    "web audio",
    "prototyping",
    "routing",
    "audio effect",
    "synthesizer",
    "webaudio",
    "creative coding"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ircam-ismm/sc-utils.git"
  },
  "exports": {
    ".": {
      "module": "./src/index.js",
      "node": "./src/index.js",
      "types": "./types/index.d.ts"
    },
    "./*.js": {
      "module": "./src/*.js",
      "node": "./src/*.js",
      "types": "./types/*.d.ts"
    }
  },
  "scripts": {
    "api": "node ./bin/jsdoc-to-md.js",
    "build": "npx esbuild src/index.js --bundle --minify --format=esm --outfile=build/bundle.js",
    "doc": "npm run api && cd docs && npm run dev",
    "doc:prod": "npm run api && cd docs && npm run build:prod",
    "lint": "eslint ./src/*.js",
    "preversion": "npm run build && npm run api && npm run types && git add -A && git commit -m 'docs: rebuild' --allow-empty",
    "test": "mocha tests/*.spec.js",
    "test:only": "mocha",
    "types": "rm -rf types && tsc"
  },
  "devDependencies": {
    "@ircam/eslint-config": "^2.0.1",
    "@ircam/sc-components": "^3.3.4",
    "chai": "^5.2.0",
    "documentation": "^14.0.3",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "hljs": "^6.2.3",
    "marked": "^15.0.11",
    "marked-highlight": "^2.2.1",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "serve": "^14.2.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@ircam/sc-loader": "^1.1.0",
    "@ircam/sc-utils": "^1.10.1",
    "isomorphic-web-audio-api": "^1.0.2"
  }
}
